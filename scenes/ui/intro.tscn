[node name="Paragraph1" type="Label" parent="Root/Center/Panel/Layout/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.99, 0.95, 0.86, 1)
theme_override_font_sizes/font_size = 27
text = "You have the opportunity to be the student of one of the most prestigious alchemists in the kingdom. He's a grumpy old man who won't let a single mistake slide, but if you manage to learn from him, you could become a true alchemist."
autowrap_mode = 3

[node name="Paragraph2" type="Label" parent="Root/Center/Panel/Layout/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.99, 0.95, 0.86, 1)
theme_override_font_sizes/font_size = 27
text = "Potion making and the alignment of the stars are cosmically connected, so it's impossible to guarantee anything. The theory, however, is simple: throw a handful of ingredients into the cauldron and stir them until something useful comes out. Do you think you can handle it?"
autowrap_mode = 3

